<div id="sky-map">
  <img src="<%= asset_path 'sky_map.jpg' %>" alt="Star Map">

  <!-- Clickable stars -->
  <div class="star-betelgeuse"
     data-name="Betelgeuse"
     data-description="A red supergiant star."
     data-distance="642.5 light-years away."
     data-lifespan="10 million-year lifespan!"
     data-fact="Betelgeuse is expected to go supernova in the next 100,000 years."
     data-size="887 times the size of Earth."></div>

  <div class="star-rigel"
     data-name="Rigel"
     data-description="A blue supergiant star."
     data-distance="860 light-years away."
     data-lifespan="8 million-year lifespan!"
     data-fact="Rigel is one of the brightest stars in our galaxy."
     data-size="78 times the size of Earth."></div>

    <div class="star-alnitak"
     data-name="Alnitak"
     data-description="The left most star in Orions belt, has a brilliant blue glow."
     data-distance="736 light-years away."
     data-lifespan="6 million-year lifespan!"
     data-fact="Part of a triple star system."
     data-size="20 times the size of Earth."></div>

     <div class="star-alnilam"
     data-name="Alnilam"
     data-description="Alnilam creates a glowing gas cloud around itself and is the brightest star in Orions Belt."
     data-distance="1,344 light-years away."
     data-lifespan="4 million-year lifespan!"
     data-fact="Middle-most star in Orions belt."
     data-size="24 times the size of Earth."></div>

     <div class="star-mintaka"
     data-name="Mintaka"
     data-description="A massive blue star that emits intense ultraviolet radiation, and right-most star in Orions Belt."
     data-distance="916 light-years away."
     data-lifespan="4 million-year lifespan!"
     data-fact="Visible from all inhabited parts of Earth."
     data-size="16 times the size of Earth."></div>


     <div class="star-orion_nebula"
     data-name="Orions Nebula"
     data-description="Orion’s Nebula is a massive star-forming region located below Orion’s Belt. It's one of the brightest nebulae visible to the naked eye."
     data-distance="1,344 light-years away."
     data-lifespan="The stars forming inside the nebula will live for millions to billions of years, depending on their size."
     data-fact="The Orion Nebula is a stellar nursery, where thousands of new stars are born, including protoplanetary disks — the building blocks of planets."
     data-size="17.8 BILLION times the size of Earth, wow!"></div>


     
   <!-- Info box -->
  <div id="info-box" style="display: none;">
    <h3 id="star-name"></h3>
    <p id="star-description"></p>
    <p id="star-distance"></p>
    <p id="star-lifespan"></p>
    <p id="star-fact"></p>
    <p id="star-size"></p>
  </div>
</div>