<div class="add-star-container">
  <h1>Add a New Star</h1>

  <% if @star.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@star.errors.count, "error") %> prohibited this star from being saved:</h2>
      <ul>
        <% @star.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @star, local: true do |form| %>
    <div>
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>

    <div>
      <%= form.label :description %>
      <%= form.text_area :description %>
    </div>

    <div>
      <%= form.label :distance %>
      <%= form.text_field :distance %>
    </div>

    <div>
      <%= form.label :lifespan %>
      <%= form.text_field :lifespan %>
    </div>

    <div>
      <%= form.label :fact %>
      <%= form.text_area :fact %>
    </div>

    <div>
      <%= form.label :size %>
      <%= form.text_field :size %>
    </div>

    <div>
      <%= form.submit "Create Star" %>
    </div>
  <% end %>
</div>
