<div id="sky-map">
  <img src="<%= asset_path 'sky_map.jpg' %>" alt="Star Map">

  <!-- Render stars dynamically from the database -->
  <% @stars.each do |star| %>
    <div class="star star-<%= star.name.parameterize %>"
         data-description="<%= star.name %>"
         data-description="<%= star.description %>"
         data-distance="<%= star.distance %>"
         data-lifespan="<%= star.lifespan %>"
         data-fact="<%= star.fact %>"
         data-size="<%= star.size %>" >

     </div>    
 <% end %>    


     
   <!-- Info box -->
  <div id="info-box" style="display: none;">
    <h3 id="star-name"></h3>
    <p id="star-description"></p>
    <p id="star-distance"></p>
    <p id="star-lifespan"></p>
    <p id="star-fact"></p>
    <p id="star-size"></p>
  </div>
</div>